{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["server/**/*.js", "client/src/**/*.js", "client/src/**/*.jsx", "test/**/*.js", "scripts/*.mjs"],
  "exclude": ["node_modules", "dist", "data"]
}
