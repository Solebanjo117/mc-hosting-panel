{
  "name": "mc-hosting-panel",
  "version": "0.20.1",
  "description": "Panel propio de hosting de Minecraft Java: crea, administra y comparte servidores desde tu PC con Windows.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node test/run.js",
    "test:unit": "node test/run.js unit",
    "test:api": "node test/run.js api",
    "test:e2e": "node test/run.js e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^5.0.0",
    "dompurify": "^3.4.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "marked": "^16.0.0",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
